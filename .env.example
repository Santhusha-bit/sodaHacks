# ─── ElevenLabs TTS ────────────────────────────────────────────────────────────
# Get your key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Voice ID to use (default: Rachel — calm, clear)
# Browse voices at: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ─── Hume AI ───────────────────────────────────────────────────────────────────
# Get your key from: https://platform.hume.ai/settings/keys
HUME_API_KEY=your_hume_api_key_here

# Hume EVI Config ID (optional — uses default if blank)
HUME_CONFIG_ID=

# ─── ESP32 Serial Connection ───────────────────────────────────────────────────
# macOS example:  /dev/cu.usbserial-XXXX  or  /dev/cu.SLAB_USBtoUART
# Linux example:  /dev/ttyUSB0
# Windows example: COM3
SERIAL_PORT=/dev/cu.usbserial-0001
SERIAL_BAUD=115200

# ─── Traffic Scraper ───────────────────────────────────────────────────────────
# City/location to monitor for traffic incidents
SCRAPE_LOCATION=San Francisco, CA

# How often (seconds) to re-scrape traffic data
TRAFFIC_POLL_INTERVAL=120

# ─── Agent Behaviour ───────────────────────────────────────────────────────────
# PIR motion detection cooldown in seconds (avoids alert spam)
PIR_COOLDOWN_SECONDS=5

# Hume stress threshold (0.0–1.0) to escalate alerts
HUME_STRESS_THRESHOLD=0.65

# Dashboard WebSocket port
WS_PORT=8765
